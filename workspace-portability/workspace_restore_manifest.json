{
  "version": 2,
  "host_dependencies": {
    "restore_only": {
      "commands": ["git", "python3", "tar", "rclone"],
      "apt": ["git", "curl", "ca-certificates", "python3", "python3-venv", "tar", "gzip", "zstd", "rclone", "jq"],
      "dnf": ["git", "curl", "ca-certificates", "python3", "python3-pip", "tar", "gzip", "zstd", "rclone", "jq"]
    },
    "full": {
      "commands": ["git", "python3", "tar", "rclone", "uv", "node", "npm", "pnpm", "docker", "docker-compose", "age"],
      "apt": ["git", "curl", "ca-certificates", "python3", "python3-venv", "tar", "gzip", "zstd", "rclone", "jq", "nodejs", "npm", "age", "docker.io"],
      "dnf": ["git", "curl", "ca-certificates", "python3", "python3-pip", "tar", "gzip", "zstd", "rclone", "jq", "nodejs", "npm", "age", "docker", "docker-compose"]
    }
  },
  "snapshot": {
    "remote": "workspace:workspace-critical-snapshot",
    "artifact_prefix": "workspace_critical_snapshot_",
    "extract_root": "workspace-critical-snapshot",
    "target_dir": "/home/anupam/Desktop/backup_data/workspace-critical-snapshot",
    "extensions": [".tar.gz", ".tar.gz.age"],
    "remote_retention_count": 5,
    "default_encryption": "none"
  },
  "large_assets_snapshot": {
    "remote": "workspace:workspace-large-assets",
    "artifact_prefix": "workspace_large_assets_",
    "extract_root": "workspace-large-assets",
    "target_dir": "/home/anupam/Desktop/backup_data/workspace-large-assets",
    "extensions": [".tar.gz", ".tar.gz.age"],
    "remote_retention_count": 2,
    "default_encryption": "none"
  },
  "repos": [
    {
      "path": ".",
      "primary_remote": "origin",
      "clone_url": "https://github.com/ak47-arch/workspace.git",
      "branch": "master",
      "extra_remotes": {}
    },
    {
      "path": "agent-browser",
      "primary_remote": "origin",
      "clone_url": "https://github.com/vercel-labs/agent-browser.git",
      "branch": "main",
      "extra_remotes": {}
    },
    {
      "path": "backup-tool",
      "primary_remote": "origin",
      "clone_url": "https://github.com/ak47-arch/backup-tool.git",
      "branch": "master",
      "extra_remotes": {}
    },
    {
      "path": "emotional_architecture",
      "primary_remote": "origin",
      "clone_url": "https://github.com/ak47-arch/emotional_architecture.git",
      "branch": "master",
      "extra_remotes": {}
    },
    {
      "path": "feed_analyser",
      "primary_remote": "origin",
      "clone_url": "https://github.com/forthechemicals/forthechemicals_agentic_social_media.git",
      "branch": "master",
      "extra_remotes": {}
    },
    {
      "path": "hermes",
      "primary_remote": "origin",
      "clone_url": "https://github.com/ak47-arch/hermes.git",
      "branch": "main",
      "extra_remotes": {
        "upstream": "https://github.com/NousResearch/hermes-agent.git"
      }
    },
    {
      "path": "llm",
      "primary_remote": "origin",
      "clone_url": "https://github.com/ak47-arch/llamacpp_inference_server.git",
      "branch": "pi_master",
      "extra_remotes": {}
    },
    {
      "path": "pi-mono",
      "primary_remote": "origin",
      "clone_url": "https://github.com/ak47-arch/pi-mono.git",
      "branch": "main",
      "extra_remotes": {
        "upstream": "https://github.com/earendil-works/pi.git"
      }
    },
    {
      "path": "skills",
      "primary_remote": "origin",
      "clone_url": "https://github.com/ak47-arch/skills.git",
      "branch": "main",
      "extra_remotes": {
        "upstream": "https://github.com/mattpocock/skills.git"
      }
    },
    {
      "path": "survival-infrastructure",
      "primary_remote": "incident-remote",
      "clone_url": "https://github.com/ak47-arch/survival-infrastructure.git",
      "branch": "pi_master",
      "extra_remotes": {}
    }
  ],
  "restore_paths": [
    "survival-infrastructure/data",
    "survival-infrastructure/data-prod",
    "survival-infrastructure/data_prod_copy",
    "survival-infrastructure/.runtime-data",
    "survival-infrastructure/.env",
    "feed_analyser/backend/data.db",
    "feed_analyser/backend/raw_data",
    "feed_analyser/backend/archive",
    "hermes/.hermes-data"
  ],
  "large_assets": [
    {
      "name": "llm-gemma-models",
      "path": "llm/gemma",
      "snapshot_path": "llm/gemma",
      "required": true,
      "description": "Standalone LLM model directory required by llm/docker-compose.yml"
    },
    {
      "name": "survival-gemma-models",
      "path": "survival-infrastructure/llm/gemma",
      "snapshot_path": "survival-infrastructure/llm/gemma",
      "required": true,
      "description": "Survival infrastructure model directory mounted by local compose workflows"
    }
  ],
  "secrets": [
    {
      "name": "survival-env-file",
      "type": "file",
      "path": "survival-infrastructure/.env",
      "strategy": "snapshot-or-secrets-dir",
      "required": true
    },
    {
      "name": "hermes-env-file",
      "type": "file",
      "path": "hermes/.hermes-data/.env",
      "strategy": "snapshot-or-secrets-dir",
      "required": false
    },
    {
      "name": "llama-cpp-dir",
      "type": "env",
      "env": "LLAMA_CPP_DIR",
      "required": true,
      "phases": ["startup"],
      "description": "Path to a llama.cpp checkout containing llama-server for the standalone llm compose stack"
    },
    {
      "name": "survival-llama-cpp-dir",
      "type": "env-or-file-key",
      "env": "SURVIVAL_LLAMA_CPP_DIR",
      "file": "survival-infrastructure/.env",
      "key": "SURVIVAL_LLAMA_CPP_DIR",
      "required": true,
      "phases": ["startup"],
      "description": "llama.cpp path used by survival-infrastructure docker-compose"
    }
  ],
  "setup_steps": [
    {
      "name": "agent-browser-deps",
      "cwd": "agent-browser",
      "commands": ["pnpm install --frozen-lockfile"],
      "required_commands": ["pnpm"]
    },
    {
      "name": "feed-analyser-backend-deps",
      "cwd": "feed_analyser/backend",
      "commands": [
        "python3 -m venv .venv",
        "./.venv/bin/pip install --upgrade pip",
        "./.venv/bin/pip install -r requirements.txt"
      ],
      "required_commands": ["python3"]
    },
    {
      "name": "feed-analyser-frontend-deps",
      "cwd": "feed_analyser/frontend",
      "commands": ["npm ci"],
      "required_commands": ["npm"]
    },
    {
      "name": "hermes-python-deps",
      "cwd": "hermes",
      "commands": ["UV_PROJECT_ENVIRONMENT=venv uv sync --extra all --locked"],
      "required_commands": ["uv"]
    },
    {
      "name": "hermes-node-deps",
      "cwd": "hermes",
      "commands": ["npm install"],
      "required_commands": ["npm"]
    },
    {
      "name": "llm-deps",
      "cwd": "llm",
      "commands": [
        "python3 -m venv .venv",
        "./.venv/bin/pip install --upgrade pip",
        "./.venv/bin/pip install -r requirements.txt"
      ],
      "required_commands": ["python3"]
    },
    {
      "name": "pi-mono-deps",
      "cwd": "pi-mono",
      "commands": ["npm install"],
      "required_commands": ["npm"]
    },
    {
      "name": "survival-infrastructure-deps",
      "cwd": "survival-infrastructure",
      "commands": [
        "python3 -m venv .venv",
        "./.venv/bin/pip install --upgrade pip",
        "./.venv/bin/pip install -r requirements.txt"
      ],
      "required_commands": ["python3"]
    }
  ],
  "startup": {
    "cwd": "survival-infrastructure",
    "command": ["./start_stack.sh"],
    "default_targets": ["app-dev"],
    "targets": {
      "app-dev": {
        "required_large_assets": ["llm-gemma-models", "survival-gemma-models"],
        "required_env": ["LLAMA_CPP_DIR"],
        "healthchecks": [
          { "type": "http", "url": "http://127.0.0.1:8012/ready" },
          { "type": "http", "url": "http://127.0.0.1:5151/api/captures" }
        ]
      },
      "app-prod": {
        "required_large_assets": ["llm-gemma-models", "survival-gemma-models"],
        "required_env": ["LLAMA_CPP_DIR"],
        "healthchecks": [
          { "type": "http", "url": "http://127.0.0.1:8012/ready" },
          { "type": "http", "url": "http://127.0.0.1:5152/api/captures" }
        ]
      },
      "app-prod-copy": {
        "required_large_assets": ["llm-gemma-models", "survival-gemma-models"],
        "required_env": ["LLAMA_CPP_DIR"],
        "healthchecks": [
          { "type": "http", "url": "http://127.0.0.1:8012/ready" },
          { "type": "http", "url": "http://127.0.0.1:5153/api/captures" }
        ]
      },
      "hermes": {
        "required_env": ["LLAMA_CPP_DIR"],
        "healthchecks": [
          { "type": "container", "name": "hermes-agent" }
        ]
      },
      "llm": {
        "required_large_assets": ["llm-gemma-models"],
        "required_env": ["LLAMA_CPP_DIR"],
        "healthchecks": [
          { "type": "http", "url": "http://127.0.0.1:8012/ready" }
        ]
      }
    }
  }
}
